{
  "name": "deepsight-site",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:sync": "node ./scripts/sync-docs.mjs",
    "docs:dev": "npm run docs:sync && vitepress dev .",
    "docs:build": "npm run docs:sync && vitepress build .",
    "docs:build:ci": "vitepress build .",
    "docs:preview": "vitepress preview .",
    "publish": "bash ./scripts/publish.sh"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.13"
  }
}
